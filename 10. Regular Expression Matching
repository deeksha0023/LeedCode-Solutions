/**
 * @param {string} s
 * @param {string} p
 * @return {boolean}
 */
var isMatch = function(s, p) {
    function check(i, j) {
        if (j === p.length) {
            return i === s.length;
        }
        let match = (i < s.length && 
                    (s[i] === p[j] || p[j] === '.'));
        if (j + 1 < p.length && p[j + 1] === '*') {
            return check(i, j + 2) || (match && check(i + 1, j));
        }
        return match && check(i + 1, j + 1);
    }
    return check(0, 0);
};
